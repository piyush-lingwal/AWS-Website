# ==============================================================================
# AWS SBG Tula's University - Environment Configuration
# ==============================================================================

# --- Supabase Database Configuration ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Recruitment Status ('open' | 'closed' | 'upcoming' | 'auto') ---
NEXT_PUBLIC_RECRUITMENT_STATUS=open

# ==============================================================================
# Automated Transactional Email Configuration (Choose Option A or Option B)
# ==============================================================================

# --- Option A: Resend API (Recommended - Fast & High Deliverability) ---
# Sign up free at https://resend.com and generate an API key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# From address (use onboarding@resend.dev for testing or your verified domain)
EMAIL_FROM=AWS Student Builders Group <onboarding@resend.dev>

# --- Option B: Nodemailer with Gmail SMTP ---
# 1. Enable 2-Step Verification in your Google Account
# 2. Generate an App Password at: https://myaccount.google.com/apppasswords
# GMAIL_USER=your-email@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# --- Option C: Custom SMTP Server / AWS SES SMTP ---
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
# SMTP_SECURE=false
